<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    android:splitMotionEvents="false">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:text="@string/disconnected" />

    <LinearLayout
        android:id="@+id/manual_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <Button
            android:id="@+id/forward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/forward" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/left" />

            <Button
                android:id="@+id/right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/right" />
        </LinearLayout>

        <Button
            android:id="@+id/reverse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reverse" />

        <Button
            android:id="@+id/open_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_camera" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/camera_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/camera_mode_title"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#101820"
            android:clipToOutline="true"
            android:foreground="@drawable/camera_frame"
            android:foregroundGravity="fill"
            android:outlineProvider="background">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible"
                app:scaleType="fillCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/camera_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/camera_starting" />

        <Button
            android:id="@+id/camera_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/close_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close_camera" />
    </LinearLayout>
</LinearLayout>
